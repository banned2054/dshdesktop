<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DshDesktop.ViewModels"
             xmlns:conversation="using:DshDesktop.Presentation.Views.Conversation"
             xmlns:tooling="using:DshDesktop.Presentation.Views.Tooling"
             x:Class="DshDesktop.Presentation.Views.Conversation.ComposerView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="720">
    <!-- 输入/发送区：固定占住聊天窗口底部一行，不再叠放覆盖消息内容。
         左侧工具栏与底部统计栏是视觉占位：附件与统计的协议链路未接入，
         保持禁用或以 — 展示，不伪装成可用功能。 -->
    <StackPanel Spacing="6">
        <Border x:Name="ComposerSurface" Classes="composer-panel">
            <StackPanel Spacing="8">
                <!-- 审批横幅：选中会话的待决 approval/request 瀑布，裁决经 $events/result 回执。 -->
                <ItemsControl ItemsSource="{Binding SessionPendingApprovals}"
                              IsVisible="{Binding HasSessionPendingApprovals}">
                    <ItemsControl.DataTemplates>
                        <DataTemplate x:DataType="vm:PendingApprovalViewModel">
                            <tooling:ApprovalPromptView />
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
                <TextBlock Text="{Binding ErrorText}"
                           IsVisible="{Binding HasError}"
                           Foreground="{DynamicResource StatusErrorBrush}"
                           TextWrapping="Wrap" />
                <TextBox x:Name="MessageInput"
                         Classes="composer-input"
                         Text="{Binding Composer.DraftMessage, Mode=TwoWay}"
                         PlaceholderText="输入消息…"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <!-- 工具行：左侧为附件占位与执行权限预设，右侧模型选择与发送按钮同基线，
                     对齐 WebUI 的 Input_Bottom chrome。 -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Button Classes="composer-icon"
                            IsEnabled="False"
                            VerticalAlignment="Center"
                            ToolTip.Tip="附件功能尚未接入">
                        <Viewbox Width="15" Height="15">
                            <Path Data="{StaticResource Icon.PlusLarge}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="2" />
                        </Viewbox>
                    </Button>
                    <!-- 执行权限预设紧贴左侧加号；仅在有选中会话时可见（权限是会话级状态）。
                         右侧区域：模型/推理等级选择与发送/停止同基线；两级弹出菜单为
                         ComposerView 与新对话草稿页共用的 ModelPickerView 控件。 -->
                    <conversation:PermissionSelectorView Grid.Column="1" VerticalAlignment="Center"
                                                         DataContext="{Binding PermissionSelector}" />
                    <conversation:ModelPickerView Grid.Column="3" VerticalAlignment="Center"
                                                  DataContext="{Binding Composer}" />
                    <Panel Grid.Column="4" Width="34" Height="34">
                        <Button Classes="composer-stop"
                                Command="{Binding Composer.CancelCommand}"
                                IsVisible="{Binding Composer.IsSessionRunning}"
                                ToolTip.Tip="停止生成">
                            <Viewbox Width="15" Height="15">
                                <Path
                                    Data="{StaticResource Icon.StopFill}"
                                    Fill="{Binding $parent[Button].Foreground}" />
                            </Viewbox>
                        </Button>
                        <Button Classes="composer-send"
                                Command="{Binding Composer.SendMessageCommand}"
                                IsVisible="{Binding !Composer.IsSessionRunning}"
                                ToolTip.Tip="发送">
                            <Viewbox Width="16" Height="16">
                                <!-- Path 显式撑满 24 viewBox：无尺寸时期望尺寸取几何 bounds，
                                     Viewbox 按它缩放会使几何偏离槽中心（图标不在圆心）。 -->
                                <Path Width="24" Height="24"
                                      Data="{StaticResource Icon.ArrowUp}"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeThickness="2" />
                            </Viewbox>
                        </Button>
                    </Panel>
                </Grid>
            </StackPanel>
        </Border>
        <!-- whole-log 投影的统计条位于卡片外侧，保持 WebUI 的轻量底部信息带；
             空会话（无步数且无计费 token）整体隐藏，与 WebUI StatsPills 口径一致。 -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Classes="composer-stats"
                        Orientation="Horizontal"
                        IsVisible="{Binding Composer.HasStatsData}"
                        ToolTip.Tip="{Binding Composer.UsageDetailText}">
                <TextBlock Text="{Binding Composer.UsageValueText}" Classes="composer-stat" />
                <TextBlock Text="{Binding Composer.CacheHitValueText}" Classes="composer-stat" />
                <TextBlock Text="{Binding Composer.SpeedValueText}" Classes="composer-stat"
                           ToolTip.Tip="{Binding Composer.StatsDetailText}" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="Enter 发送 · Shift+Enter 换行"
                       Classes="composer-stat" />
        </Grid>
    </StackPanel>
</UserControl>
