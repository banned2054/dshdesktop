<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DshDesktop.ViewModels"
             x:Class="DshDesktop.Presentation.Views.Conversation.ModelPickerView"
             x:DataType="vm:ComposerViewModel"
             mc:Ignorable="d"
             d:DesignHeight="34" d:DesignWidth="200">
    <!-- 模型/推理等级选择：按钮 + 两级弹出菜单。底部输入区与新对话草稿页共用，
         绑定同一 ComposerViewModel；草稿页模式下选择只做本地预选（无 RPC）。 -->
    <Panel>
        <Button x:Name="ModelPickerButton"
                Classes="model-picker-button"
                Command="{Binding ToggleModelMenuCommand}"
                IsEnabled="{Binding IsModelPickerEnabled}"
                AutomationProperties.Name="选择模型与推理等级"
                ToolTip.Tip="模型与推理等级">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBlock Text="{Binding ModelPickerLabel}"
                           TextTrimming="CharacterEllipsis" />
                <Path Grid.Column="1"
                      Data="M0,0 L4,4 L8,0"
                      Width="8" Height="4"
                      Stretch="None"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.6"
                      VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Popup x:Name="ModelPickerPopup"
               PlacementTarget="{Binding #ModelPickerButton}"
               Placement="Top"
               VerticalOffset="-4"
               IsOpen="{Binding IsModelMenuOpen, Mode=TwoWay}"
               IsLightDismissEnabled="True">
            <Border Classes="popup-surface" Width="264" MaxHeight="420">
                <Panel>
                    <!-- 主菜单：模型 / 推理等级 两行导航，右侧展示当前值。 -->
                    <StackPanel IsVisible="{Binding IsModelMenuRootPage}">
                        <Button Classes="popup-navigation"
                                Command="{Binding ShowModelsPageCommand}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="模型" />
                                <TextBlock Grid.Column="1"
                                           Classes="popup-value"
                                           Text="{Binding CurrentModelNameText}" />
                                <TextBlock Grid.Column="2" Classes="popup-chevron" Text="›" />
                            </Grid>
                        </Button>
                        <Button Classes="popup-navigation"
                                Command="{Binding ShowEffortsPageCommand}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="推理等级" />
                                <TextBlock Grid.Column="1"
                                           Classes="popup-value"
                                           Text="{Binding CurrentEffortText}" />
                                <TextBlock Grid.Column="2" Classes="popup-chevron" Text="›" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <!-- 模型二级菜单：提供方作分组标题，模型单独成行，当前模型勾选。 -->
                    <ScrollViewer IsVisible="{Binding IsModelsMenuPage}" MaxHeight="380">
                        <StackPanel>
                            <Button Classes="popup-navigation"
                                    Command="{Binding ShowModelMenuRootCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="popup-chevron" Text="‹" />
                                    <TextBlock Text="模型" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding ModelGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModelGroupMenuViewModel">
                                        <StackPanel>
                                            <TextBlock Classes="popup-section" Text="{Binding Name}" />
                                            <ItemsControl ItemsSource="{Binding Options}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ModelOptionViewModel">
                                                        <Button Classes="popup-item"
                                                                Classes.selected="{Binding IsSelected}"
                                                                Command="{Binding SelectCommand}"
                                                                ToolTip.Tip="{Binding ProviderName}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding ModelName}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1"
                                                                           Classes="popup-check"
                                                                           Text="✓"
                                                                           IsVisible="{Binding IsSelected}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- 推理等级二级菜单：off/low/high/max，当前档位按回声勾选。 -->
                    <StackPanel IsVisible="{Binding IsEffortsMenuPage}">
                        <Button Classes="popup-navigation"
                                Command="{Binding ShowModelMenuRootCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="popup-chevron" Text="‹" />
                                <TextBlock Text="推理等级" />
                            </StackPanel>
                        </Button>
                        <ItemsControl ItemsSource="{Binding EffortOptions}" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EffortOptionViewModel">
                                    <Button Classes="popup-item"
                                            Classes.selected="{Binding IsSelected}"
                                            Command="{Binding SelectCommand}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="popup-check"
                                                       Text="✓"
                                                       IsVisible="{Binding IsSelected}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Panel>
            </Border>
        </Popup>
    </Panel>
</UserControl>
