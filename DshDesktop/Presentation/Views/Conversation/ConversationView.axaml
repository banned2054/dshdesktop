<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DshDesktop.ViewModels"
             xmlns:diff="using:Banned.CodeDiff.Avalonia.Views"
             xmlns:conversation="using:DshDesktop.Presentation.Views.Conversation"
             xmlns:tooling="using:DshDesktop.Presentation.Views.Tooling"
             x:Class="DshDesktop.Presentation.Views.Conversation.ConversationView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1000">
    <!-- 会话主区域：会话头部 + 消息时间线 + 输入区。滚动贴底与前插锚定行为见本视图
         code-behind；窗口 chrome（标题栏、侧栏开关）是 MainWindow 级视图，不属于本区域。 -->
    <Grid x:Name="ConversationLayoutGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="560" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="0" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{DynamicResource ChatBackgroundBrush}" MinWidth="560"
              RowDefinitions="Auto,*,Auto">
            <conversation:SessionHeaderView Grid.Row="0" />

        <ScrollViewer Grid.Row="1" x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding !ShowNewConversationPage}">
            <!-- 留白属于被滚动内容的一部分：挂在 ScrollViewer 上时 presenter 的 Padding
                 不计入 extent，滚到底也会截掉一段（气泡底部不可达）。
                 MaxWidth 与底部输入区同列：窗口更宽时整列水平居中（见 Conversation 样式）。 -->
            <Border x:Name="MessagesContent" Padding="28,22"
                    MaxWidth="{StaticResource ConversationColumnMaxWidth}">
                <StackPanel Spacing="8">
                    <!-- 历史分页按钮随内容滚动，位于时间线顶端；点击加载一页更早消息。 -->
                    <Button Classes="load-older"
                            Content="{Binding LoadOlderText}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding HasMoreHistory}"
                            Click="OnLoadOlderClick" />
                    <ItemsControl x:Name="ConversationItemsControl" ItemsSource="{Binding ConversationItems}">
                        <ItemsControl.DataTemplates>
                            <DataTemplate x:DataType="vm:MessageItemViewModel">
                                <conversation:MessageView />
                            </DataTemplate>
                            <DataTemplate x:DataType="vm:ToolActivityItemViewModel">
                                <!-- 运行中轮次的工具卡片：turn/end 后折叠进过程组。 -->
                                <tooling:ToolActivityView />
                            </DataTemplate>
                            <DataTemplate x:DataType="vm:WorkspaceChangesCardViewModel">
                                <Panel>
                                    <!-- 单文件：整卡可点打开右侧对比，右侧「查看变更」按钮执行同一命令。 -->
                                    <Button Classes="changes-single"
                                            Command="{Binding SelectFileCommand}"
                                            CommandParameter="{Binding SingleFile}"
                                            IsVisible="{Binding IsSingleFile}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0" Classes="changes-badge"
                                                    VerticalAlignment="Center">
                                                <Panel Classes="row-leading" Width="16" Height="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource Icon.EditBodyFill}"
                                                          Fill="{DynamicResource ToolRowLabelHoverBrush}" />
                                                    <Path Data="{StaticResource Icon.EditPenStroke}"
                                                          Stroke="{DynamicResource ToolRowLabelHoverBrush}"
                                                          StrokeThickness="1" />
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Classes="changes-title" Text="{Binding SingleTitleText}"
                                                           ToolTip.Tip="{Binding SingleFile.Display}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Panel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                IsVisible="{Binding SingleHasLineCounts}">
                                                        <TextBlock Classes="changes-added"
                                                                   Text="{Binding SingleFile.AddedText}" />
                                                        <TextBlock Classes="changes-deleted"
                                                                   Text="{Binding SingleFile.DeletedText}" />
                                                    </StackPanel>
                                                    <TextBlock Classes="changes-count"
                                                               Text="{Binding SingleFile.CountText}"
                                                               IsVisible="{Binding !SingleHasLineCounts}" />
                                                </Panel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="changes-action" Content="查看变更"
                                                    Command="{Binding SelectFileCommand}"
                                                    CommandParameter="{Binding SingleFile}"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <!-- 多文件与加载/失败态：头部静态不响应点击，仅文件行可点；
                                         超过 3 行折叠，增删列跨行共享宽度对齐。 -->
                                    <Border Classes="changes-card" IsVisible="{Binding !IsSingleFile}">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="4,4,4,8">
                                                <Border Grid.Column="0" Classes="changes-badge"
                                                        VerticalAlignment="Center">
                                                    <Panel Classes="row-leading" Width="16" Height="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource Icon.EditBodyFill}"
                                                              Fill="{DynamicResource ToolRowLabelHoverBrush}" />
                                                        <Path Data="{StaticResource Icon.EditPenStroke}"
                                                              Stroke="{DynamicResource ToolRowLabelHoverBrush}"
                                                              StrokeThickness="1" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Classes="changes-title" Text="{Binding TitleText}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                IsVisible="{Binding HasTotals}">
                                                        <TextBlock Classes="changes-added"
                                                                   Text="{Binding HeaderAddedText}" />
                                                        <TextBlock Classes="changes-deleted"
                                                                   Text="{Binding HeaderDeletedText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Classes="changes-state" Text="{Binding SummaryText}"
                                                       IsVisible="{Binding HasError}" />
                                            <TextBlock Classes="changes-state" Text="{Binding SummaryText}"
                                                       IsVisible="{Binding IsUnavailable}" />
                                            <ItemsControl ItemsSource="{Binding VisibleFiles}"
                                                          IsVisible="{Binding HasFiles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:WorkspaceChangedFileViewModel">
                                                        <Button Classes="changes-file"
                                                                Classes.selected="{Binding IsSelected}"
                                                                Command="{Binding $parent[ItemsControl].DataContext.SelectFileCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="{Binding Display}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                                <Grid Grid.Column="1" ColumnSpacing="8"
                                                                      VerticalAlignment="Center">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                                                                               Classes="changes-count"
                                                                               Text="{Binding CountText}"
                                                                               IsVisible="{Binding !HasLineCounts}" />
                                                                    <TextBlock Grid.Column="0"
                                                                               Classes="changes-added"
                                                                               Text="{Binding AddedText}"
                                                                               MinWidth="34"
                                                                               TextAlignment="Right"
                                                                               IsVisible="{Binding HasLineCounts}" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Classes="changes-deleted"
                                                                               Text="{Binding DeletedText}"
                                                                               MinWidth="30"
                                                                               TextAlignment="Right"
                                                                               IsVisible="{Binding HasLineCounts}" />
                                                                </Grid>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Classes="changes-toggle" Command="{Binding ToggleCommand}"
                                                    IsVisible="{Binding HasToggle}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding ToggleText}" />
                                                    <!-- 折叠指示箭头：收起时向下，展开时向上。 -->
                                                    <Panel Width="8" Height="8" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource Icon.ChevronDown}"
                                                              Stroke="{DynamicResource TextMutedBrush}"
                                                              StrokeThickness="1.5"
                                                              IsVisible="{Binding !IsExpanded}" />
                                                        <Path Data="{StaticResource Icon.ChevronDown}"
                                                              Stroke="{DynamicResource TextMutedBrush}"
                                                              StrokeThickness="1.5"
                                                              RenderTransformOrigin="50%,50%"
                                                              RenderTransform="rotate(180deg)"
                                                              IsVisible="{Binding IsExpanded}" />
                                                    </Panel>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </DataTemplate>
                            <DataTemplate x:DataType="vm:DeliverablesCardViewModel">
                                <Panel>
                                    <!-- 单文件：整卡可点打开右侧面板，右侧「查看变更」按钮执行同一命令。 -->
                                    <Button Classes="changes-single" Command="{Binding SingleOpenCommand}"
                                            IsVisible="{Binding IsSingleFile}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0" Classes="changes-badge"
                                                    VerticalAlignment="Center">
                                                <Panel Classes="row-leading" Width="16" Height="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource Icon.ChecklistOutlineRegular}"
                                                          Stroke="{DynamicResource ToolRowLabelHoverBrush}"
                                                          StrokeThickness="1" />
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Classes="changes-title"
                                                           Text="{Binding SingleTitleText}"
                                                           ToolTip.Tip="{Binding SingleFile.Path}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Panel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                IsVisible="{Binding SingleHasLineCounts}">
                                                        <TextBlock Classes="changes-added"
                                                                   Text="{Binding SingleFile.AddedText}" />
                                                        <TextBlock Classes="changes-deleted"
                                                                   Text="{Binding SingleFile.DeletedText}" />
                                                    </StackPanel>
                                                    <TextBlock Classes="changes-count"
                                                               Text="{Binding SingleFile.CountText}"
                                                               IsVisible="{Binding SingleHasCountText}" />
                                                </Panel>
                                                <TextBlock Classes="deliverables-state"
                                                           Text="{Binding SingleStatusText}"
                                                           Classes.error="{Binding SingleHasError}"
                                                           IsVisible="{Binding SingleHasError}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="changes-action" Content="查看变更"
                                                    Command="{Binding SingleOpenCommand}"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <!-- 多文件：头部静态不响应点击，仅文件行可点；超过 3 行折叠；
                                         行左是相对根目录的声明路径，右是增删行数。 -->
                                    <Border Classes="deliverables-card" IsVisible="{Binding !IsSingleFile}">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="4,4,4,8">
                                                <Border Grid.Column="0" Classes="changes-badge"
                                                        VerticalAlignment="Center">
                                                    <Panel Classes="row-leading" Width="16" Height="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource Icon.ChecklistOutlineRegular}"
                                                              Stroke="{DynamicResource ToolRowLabelHoverBrush}"
                                                              StrokeThickness="1" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Classes="changes-title"
                                                               Text="{Binding TitleText}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                IsVisible="{Binding HasTotals}">
                                                        <TextBlock Classes="changes-added"
                                                                   Text="{Binding HeaderAddedText}" />
                                                        <TextBlock Classes="changes-deleted"
                                                                   Text="{Binding HeaderDeletedText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding VisibleFiles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DeliveredFileViewModel">
                                                        <Button Classes="changes-file"
                                                                Command="{Binding OpenCommand}"
                                                                ToolTip.Tip="{Binding Path}">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <StackPanel Grid.Column="0" Spacing="2"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Path}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding StatusText}"
                                                                               Classes="deliverables-state"
                                                                               Classes.error="{Binding HasError}"
                                                                               IsVisible="{Binding HasError}" />
                                                                </StackPanel>
                                                                <Grid Grid.Column="1" ColumnSpacing="8"
                                                                      VerticalAlignment="Center">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                                                                               Classes="changes-count"
                                                                               Text="{Binding CountText}"
                                                                               IsVisible="{Binding HasCountText}" />
                                                                    <TextBlock Grid.Column="0"
                                                                               Classes="changes-added"
                                                                               Text="{Binding AddedText}"
                                                                               MinWidth="34"
                                                                               TextAlignment="Right"
                                                                               IsVisible="{Binding HasLineCounts}" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Classes="changes-deleted"
                                                                               Text="{Binding DeletedText}"
                                                                               MinWidth="30"
                                                                               TextAlignment="Right"
                                                                               IsVisible="{Binding HasLineCounts}" />
                                                                </Grid>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Classes="changes-toggle" Command="{Binding ToggleCommand}"
                                                    IsVisible="{Binding HasToggle}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding ToggleText}" />
                                                    <!-- 折叠指示箭头：收起时向下，展开时向上。 -->
                                                    <Panel Width="8" Height="8" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource Icon.ChevronDown}"
                                                              Stroke="{DynamicResource TextMutedBrush}"
                                                              StrokeThickness="1.5"
                                                              IsVisible="{Binding !IsExpanded}" />
                                                        <Path Data="{StaticResource Icon.ChevronDown}"
                                                              Stroke="{DynamicResource TextMutedBrush}"
                                                              StrokeThickness="1.5"
                                                              RenderTransformOrigin="50%,50%"
                                                              RenderTransform="rotate(180deg)"
                                                              IsVisible="{Binding IsExpanded}" />
                                                    </Panel>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </DataTemplate>
                            <DataTemplate x:DataType="vm:TurnProcessGroupViewModel">
                                <StackPanel Margin="0,0,0,16" Spacing="6">
                                    <Button Classes="tool-toggle" Command="{Binding ToggleCommand}"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FailedText}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource StatusErrorBrush}"
                                                       IsVisible="{Binding HasFailed}" />
                                            <!-- 折叠指示箭头：收起时向右，展开时向下。 -->
                                            <Panel Width="8" Height="8" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.ChevronRight}"
                                                      Stroke="{DynamicResource TextMutedBrush}"
                                                      StrokeThickness="1.5"
                                                      IsVisible="{Binding !IsExpanded}" />
                                                <Path Data="{StaticResource Icon.ChevronDown}"
                                                      Stroke="{DynamicResource TextMutedBrush}"
                                                      StrokeThickness="1.5"
                                                      IsVisible="{Binding IsExpanded}" />
                                            </Panel>
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding SegmentedProcess}"
                                                  IsVisible="{Binding IsExpanded}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.DataTemplates>
                                            <DataTemplate x:DataType="vm:TurnProcessSegmentViewModel">
                                                <StackPanel Spacing="4">
                                                    <Button Classes="reason-row"
                                                            Classes.expanded="{Binding IsExpanded}"
                                                            Command="{Binding ToggleCommand}">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                            <Panel Grid.Column="0" Classes="row-leading"
                                                                   Width="16" Height="16"
                                                                   VerticalAlignment="Center">
                                                                <Path Classes="row-icon"
                                                                      Data="{Binding LeadingIconStroke}"
                                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                                      StrokeThickness="1" />
                                                                <Path Classes="row-icon"
                                                                      Data="{Binding LeadingIconFill}"
                                                                      Fill="{Binding $parent[Button].Foreground}" />
                                                                <Path Classes="row-chev row-chev-hover"
                                                                      Data="{StaticResource Icon.RowChevronDown}"
                                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                                      StrokeThickness="1" />
                                                                <Path Classes="row-chev row-chev-open"
                                                                      Data="{StaticResource Icon.RowChevronUp}"
                                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                                      StrokeThickness="1" />
                                                            </Panel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding SummaryText}"
                                                                       Classes="tool-summary"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                    <ItemsControl ItemsSource="{Binding Items}"
                                                                  IsVisible="{Binding IsExpanded}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.DataTemplates>
                                                            <DataTemplate x:DataType="vm:ToolActivityItemViewModel">
                                                                <tooling:ToolActivityView />
                                                            </DataTemplate>
                                                            <DataTemplate x:DataType="vm:MessageItemViewModel">
                                                                <conversation:MessageView />
                                                            </DataTemplate>
                                                        </ItemsControl.DataTemplates>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                            <DataTemplate x:DataType="vm:ToolActivityItemViewModel">
                                                <tooling:ToolActivityView />
                                            </DataTemplate>
                                            <DataTemplate x:DataType="vm:MessageItemViewModel">
                                                <conversation:MessageView />
                                            </DataTemplate>
                                        </ItemsControl.DataTemplates>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- 新对话草稿页：无选中会话时占满会话区，输入区沉底并与底部输入区同宽，
             工作区下拉贴其上缘；此时时间线与底部输入区隐藏，首发送被接受后切换到
             普通会话布局。 -->
            <conversation:NewConversationView Grid.Row="1" />

        <!-- 输入区与消息时间线同列同缘（水平 Padding 28 + 共享 MaxWidth），窗口更宽时
             与时间线一起水平居中。 -->
            <Border Grid.Row="2" Padding="28,14,28,16"
                MaxWidth="{StaticResource ConversationColumnMaxWidth}"
                IsVisible="{Binding !ShowNewConversationPage}">
            <conversation:ComposerView />
        </Border>
        </Grid>

        <!-- Session 内右侧对比区：点击改动文件或交付文件后打开。标题下第一行是数据
             来源标注（本轮文件差异 / 历史编辑片段 / 当前文件内容 / 不可用），内容区按
             形态显示 CodeDiff、片段列表或只读文本；关闭按钮恢复单列会话布局。 -->
        <Border Grid.Column="2" Classes="diff-panel"
                IsVisible="{Binding DiffPanel.IsOpen}">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,12,14,8">
                    <TextBlock Grid.Column="0" Text="{Binding DiffPanel.TitleText}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="diff-close" Command="{Binding DiffPanel.CloseCommand}"
                            Content="关闭" />
                </Grid>
                <StackPanel Grid.Row="1" Margin="14,0,14,8" Spacing="6">
                    <TextBlock Classes="diff-source" Text="{Binding DiffPanel.SourceText}"
                               IsVisible="{Binding DiffPanel.SourceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Classes="diff-status" Text="正在读取对比..."
                               IsVisible="{Binding DiffPanel.IsLoading}" />
                    <TextBlock Classes="diff-status" Text="{Binding DiffPanel.ErrorText}"
                               IsVisible="{Binding DiffPanel.HasError}" />
                    <TextBlock Classes="diff-status" Text="{Binding DiffPanel.NoticeText}"
                               IsVisible="{Binding DiffPanel.HasNotice}" />
                </StackPanel>
                <Grid Grid.Row="2" Margin="8,0,8,8">
                    <diff:DiffView DiffFile="{Binding DiffPanel.DiffFile}"
                                   IsVisible="{Binding DiffPanel.HasDiff}"
                                   SizeChanged="OnDiffViewSizeChanged"
                                   Wrap="True" />
                    <ScrollViewer IsVisible="{Binding DiffPanel.HasFragments}">
                        <ItemsControl Margin="0,0,8,0" ItemsSource="{Binding DiffPanel.Fragments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeliverableFragmentItemViewModel">
                                    <StackPanel Margin="0,0,0,10" Spacing="4">
                                        <TextBlock Classes="diff-fragment-header" Text="{Binding HeaderText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Classes="diff-fragment-box">
                                            <diff:DiffView DiffFile="{Binding DiffFile}"
                                                           SizeChanged="OnDiffViewSizeChanged"
                                                           Wrap="True" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBox Classes="diff-content" IsVisible="{Binding DiffPanel.HasContent}"
                             Text="{Binding DiffPanel.ContentText}"
                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" />
                </Grid>
                <Button Grid.Row="3" Classes="diff-open-external" Margin="14,0,14,10"
                        Content="用默认程序打开"
                        Command="{Binding DiffPanel.OpenInDefaultAppCommand}"
                        IsVisible="{Binding DiffPanel.CanOpenExternally}"
                        HorizontalAlignment="Left" />
            </Grid>
        </Border>
        <!-- 分隔条命中区不占布局宽度；声明在面板之后以覆盖边界线。 -->
        <GridSplitter x:Name="DiffPanelSplitter" Grid.Column="1"
                      Classes="sidebar-splitter"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Width="8"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      IsVisible="False" />
    </Grid>
</UserControl>
