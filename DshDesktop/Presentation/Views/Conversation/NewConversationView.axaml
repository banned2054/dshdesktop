<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DshDesktop.ViewModels"
             xmlns:conversation="using:DshDesktop.Presentation.Views.Conversation"
             x:Class="DshDesktop.Presentation.Views.Conversation.NewConversationView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="760">
    <!-- 新对话草稿页：输入区固定在会话区底部，与普通会话输入区同宽、同边距；
         工作区下拉紧贴输入框上缘左对齐（Codex 风格），标示当前项目并供切换，
         是本页与普通会话布局的唯一差别。下拉与模型/推理等级选择只改本地草稿预选，
         不调用 session/create、不收养空白会话；首发送（SendDraftCommand）按预选
         创建会话，后端接受首条消息后才进入普通会话。本页不显示会话 ID，
         也不在侧栏产生会话行。 -->
    <Panel IsVisible="{Binding ShowNewConversationPage}">
        <Grid RowDefinitions="*,Auto,Auto">
            <!-- 工作区下拉：当前项目展示于输入框上方；未选择时文案即明确的选择状态。 -->
            <Button x:Name="WorkspacePickerButton"
                    Grid.Row="1"
                    Classes="workspace-picker"
                    HorizontalAlignment="Left"
                    Margin="28,0,28,10"
                    Command="{Binding ToggleWorkspaceMenuCommand}"
                    AutomationProperties.Name="{Binding WorkspacePickerLabel}"
                    ToolTip.Tip="新对话归属的工作区">
                <!-- Auto,Auto：星号列在有限约束下按可用宽度测量会让按钮无法随内容收缩，
                     文字贴左、箭头被推到最右；两列都按内容计算才能收紧成紧凑下拉。 -->
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                    <TextBlock Text="{Binding WorkspacePickerLabel}"
                               TextTrimming="CharacterEllipsis" />
                    <Path Grid.Column="1"
                          Data="M0,0 L4,4 L8,0"
                          Width="8" Height="4"
                          Stretch="None"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1.6"
                          VerticalAlignment="Center" />
                </Grid>
            </Button>
            <!-- TopEdgeAlignedLeft：钉在按钮上方且左缘对齐（同 ModelPickerView 的 Top 惯例）。
                 不能用 Bottom 系列：按钮贴窗口底部，下方是输入区，定位器会在放不下时
                 自动翻到上方；一旦搜索过滤让面板变短、下方放得下，就会跳回下方。 -->
            <Popup x:Name="WorkspacePickerPopup"
                   PlacementTarget="{Binding #WorkspacePickerButton}"
                   Placement="TopEdgeAlignedLeft"
                   VerticalOffset="-4"
                   IsOpen="{Binding IsWorkspaceMenuOpen, Mode=TwoWay}"
                   IsLightDismissEnabled="True">
                <!-- 对齐 DSH WorkspacePickFlow 的菜单结构，顶部再加搜索行：搜索 + 滚动区
                     （真实工作区）+ 分隔线下钉「添加工作区」与「不使用工作区」固定底行。
                     面板宽度随最宽条目收缩（不设固定宽）；超长标题在行内截断兜底。 -->
                <Border Classes="popup-surface">
                    <StackPanel>
                        <!-- 搜索：输入即过滤下方列表（纯文本、忽略大小写），无需回车或按钮；
                             行几何与下方工作区行同构（图标 16 + 间距 8 + 文字），关闭面板时
                             由 VM 清空并恢复全量。 -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                              MinHeight="34" Margin="10,1">
                            <!-- DSH IconSearchOutlineRegular（16px、1px 描边）。 -->
                            <Path Width="16" Height="16" VerticalAlignment="Center"
                                  Data="M6.587,11.859 A5.366,5.366 0 0,1 6.587,1.127 A5.366,5.366 0 0,1 6.587,11.859 M10.299,10.393 L14.778,14.873"
                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1" />
                            <TextBox Grid.Column="1"
                                     Classes="popup-search"
                                     VerticalAlignment="Center"
                                     Text="{Binding WorkspaceSearchText, Mode=TwoWay}"
                                     PlaceholderText="搜索工作区"
                                     AutomationProperties.Name="搜索工作区" />
                        </Grid>
                        <Border Classes="popup-divider" />
                        <ScrollViewer MaxHeight="288" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding WorkspaceMenuOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkspaceOptionViewModel">
                                        <Button Classes="popup-item"
                                                Classes.selected="{Binding IsSelected}"
                                                Command="{Binding SelectCommand}"
                                                CommandParameter="{Binding}">
                                            <!-- 名称左侧文件夹图标与侧栏工作区分组同款
                                                 （DSH WorkspaceBrowser 16px）；选中勾紧贴
                                                 名称右侧。标题 MaxWidth 截断超长路径名。 -->
                                            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                                <Path Width="16" Height="16" VerticalAlignment="Center"
                                                      Data="M2,11.5 L2,4.5 A1.5,1.5 0 0 1 3.5,3 L6.4,3 A1.5,1.5 0 0 1 7.6,3.6 L8.6,5 L13.5,5 A1.5,1.5 0 0 1 15,6.5 L15,11.5 A1.5,1.5 0 0 1 13.5,13 L3.5,13 A1.5,1.5 0 0 1 2,11.5 Z"
                                                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                                      StrokeLineCap="Round" />
                                                <TextBlock Grid.Column="1" Text="{Binding TitleText}"
                                                           MaxWidth="300"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Path Grid.Column="2" Classes="popup-check"
                                                      Data="M2.25,8.5 L5.49732,11.7473 C5.90519,12.1552 6.57263,12.1344 6.95426,11.7018 L13.75,4"
                                                      Stroke="{DynamicResource PopupForegroundBrush}"
                                                      StrokeThickness="1"
                                                      IsVisible="{Binding IsSelected}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Classes="popup-divider" />
                        <!-- 添加工作区：文件夹对话框与侧栏入口同一视图行为（见 code-behind），
                             登记编排走 MainWindowViewModel.RegisterWorkspaceAsync。 -->
                        <Button x:Name="AddWorkspaceButton" Classes="popup-item"
                                AutomationProperties.Name="添加工作区"
                                ToolTip.Tip="添加工作区">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Path Width="16" Height="16" VerticalAlignment="Center"
                                      Data="M8,2 L8,14 M2,8 L14,8"
                                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1" />
                                <TextBlock Grid.Column="1" Text="添加工作区" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <!-- 「不使用工作区」兼容项：从滚动列表挪到固定底行，命令与勾选态
                             沿用兼容项实例；空图标列保持标题与上方工作区行对齐。 -->
                        <Button Classes="popup-item"
                                Classes.selected="{Binding WithoutWorkspaceOption.IsSelected}"
                                Command="{Binding WithoutWorkspaceOption.SelectCommand}"
                                CommandParameter="{Binding WithoutWorkspaceOption}"
                                AutomationProperties.Name="不使用工作区">
                            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                <Panel Grid.Column="0" Width="16" Height="16" />
                                <TextBlock Grid.Column="1" Text="不使用工作区" VerticalAlignment="Center" />
                                <Path Grid.Column="2" Classes="popup-check"
                                      Data="M2.25,8.5 L5.49732,11.7473 C5.90519,12.1552 6.57263,12.1344 6.95426,11.7018 L13.75,4"
                                      Stroke="{DynamicResource PopupForegroundBrush}" StrokeThickness="1"
                                      IsVisible="{Binding WithoutWorkspaceOption.IsSelected}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
            <!-- 输入卡片：与底部输入区同款面板、同宽同位置；错误提示、模型预选与发送同基线。
                 「不使用工作区」必须经下拉显式选择，发送按钮才可用。 -->
            <StackPanel Grid.Row="2" Spacing="6" Margin="28,0,28,16">
                <Border x:Name="ComposerSurface" Classes="composer-panel">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ErrorText}"
                                   IsVisible="{Binding HasError}"
                                   Foreground="{DynamicResource StatusErrorBrush}"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="MessageInput"
                                 Classes="composer-input"
                                 AutomationProperties.Name="新对话输入框"
                                 Text="{Binding Composer.DraftMessage, Mode=TwoWay}"
                                 PlaceholderText="输入消息…"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                            <Button Classes="composer-icon"
                                    IsEnabled="False"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="附件功能尚未接入">
                                <Viewbox Width="15" Height="15">
                                    <Path Data="M12 5v14M5 12h14"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="2" />
                                </Viewbox>
                            </Button>
                            <conversation:ModelPickerView Grid.Column="2" VerticalAlignment="Center"
                                                          DataContext="{Binding Composer}" />
                            <Button Grid.Column="3"
                                    Classes="composer-send"
                                    Command="{Binding SendDraftCommand}"
                                    AutomationProperties.Name="发送首条消息"
                                    ToolTip.Tip="发送">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="M12 19V5M5 12l7-7 7 7"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="2" />
                                </Viewbox>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- 卡片外侧信息带：与普通会话输入区同构——左侧草稿发送状态、右侧键盘提示，
                     保持两页底部基线一致。 -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="正在创建会话并发送首条消息…"
                               Classes="composer-stat"
                               IsVisible="{Binding IsStartingConversation}" />
                    <TextBlock Grid.Column="1"
                               Text="Enter 发送 · Shift+Enter 换行"
                               Classes="composer-stat" />
                </Grid>
            </StackPanel>
        </Grid>
    </Panel>
</UserControl>
