<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DshDesktop.ViewModels"
             xmlns:conversation="using:DshDesktop.Presentation.Views.Conversation"
             x:Class="DshDesktop.Presentation.Views.Conversation.NewConversationView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="760">
    <!-- 新对话草稿页：输入区固定在会话区底部，与普通会话输入区同宽、同边距；
         工作区与模式下拉紧贴输入框上缘左对齐（Codex 风格），标示当前项目与将绑定的
         dsh Agent 预设（模式），供首发送前切换。模式只在新建会话时可选，会话开始后
         由后端锁定，故普通会话页没有此按钮。下拉与模型/推理等级选择只改本地草稿预选，
         不调用 session/create、不收养空白会话；首发送（SendDraftCommand）按预选
         创建会话，后端接受首条消息后才进入普通会话。本页不显示会话 ID，
         也不在侧栏产生会话行。 -->
    <Panel IsVisible="{Binding ShowNewConversationPage}">
        <Grid RowDefinitions="*,Auto,Auto">
            <!-- 下拉按钮行：当前项目与当前模式并排展示于输入框上方；未选择时文案即
                 明确的选择状态（模式始终有内置默认「标准模式」）。 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="28,0,28,10">
                <Button x:Name="WorkspacePickerButton"
                        Classes="workspace-picker"
                        Command="{Binding ToggleWorkspaceMenuCommand}"
                        AutomationProperties.Name="{Binding WorkspacePickerLabel}"
                        ToolTip.Tip="新对话归属的工作区">
                    <!-- Auto,Auto：星号列在有限约束下按可用宽度测量会让按钮无法随内容收缩，
                         文字贴左、箭头被推到最右；两列都按内容计算才能收紧成紧凑下拉。 -->
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding WorkspacePickerLabel}"
                                   TextTrimming="CharacterEllipsis" />
                        <Path Grid.Column="1"
                              Data="{StaticResource Icon.DropdownChevron}"
                              Width="8" Height="4"
                              Stretch="None"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.6"
                              VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button x:Name="PresetPickerButton"
                        Classes="workspace-picker"
                        Command="{Binding TogglePresetMenuCommand}"
                        AutomationProperties.Name="{Binding PresetPickerLabel}"
                        ToolTip.Tip="新对话使用的模式，会话开始后固定">
                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                        <!-- DSH IconAgentPresetOutlineRegular（16px）：三个节点圆与
                             连接弧，对应模式的 Agent 预设语义；填充弧用 Fill，
                             节点圆用 1px 描边。 -->
                        <Canvas Width="16" Height="16" VerticalAlignment="Center">
                            <Path
                                Data="{StaticResource Icon.AgentPresetArcsFill}"
                                Fill="{Binding $parent[Button].Foreground}" />
                            <Ellipse Width="8" Height="8" Canvas.Left="3.99136" Canvas.Top="-0.31895"
                                     Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
                            <Ellipse Width="8" Height="8" Canvas.Left="-0.05991" Canvas.Top="7.7417"
                                     Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
                            <Ellipse Width="8" Height="8" Canvas.Left="8.0851" Canvas.Top="7.7417"
                                     Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
                        </Canvas>
                        <TextBlock Grid.Column="1" Text="{Binding PresetPickerLabel}"
                                   TextTrimming="CharacterEllipsis" />
                        <Path Grid.Column="2"
                              Data="{StaticResource Icon.DropdownChevron}"
                              Width="8" Height="4"
                              Stretch="None"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.6"
                              VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
            <!-- TopEdgeAlignedLeft：钉在按钮上方且左缘对齐（同 ModelPickerView 的 Top 惯例）。
                 不能用 Bottom 系列：按钮贴窗口底部，下方是输入区，定位器会在放不下时
                 自动翻到上方；一旦搜索过滤让面板变短、下方放得下，就会跳回下方。 -->
            <Popup x:Name="WorkspacePickerPopup"
                   PlacementTarget="{Binding #WorkspacePickerButton}"
                   Placement="TopEdgeAlignedLeft"
                   VerticalOffset="-4"
                   IsOpen="{Binding IsWorkspaceMenuOpen, Mode=TwoWay}"
                   IsLightDismissEnabled="True">
                <!-- 对齐 DSH WorkspacePickFlow 的菜单结构，顶部再加搜索行：搜索 + 滚动区
                     （真实工作区）+ 分隔线下钉「添加工作区」与「不使用工作区」固定底行。
                     面板宽度随最宽条目收缩（不设固定宽）；超长标题在行内截断兜底。 -->
                <Border Classes="popup-surface">
                    <StackPanel>
                        <!-- 搜索：输入即过滤下方列表（纯文本、忽略大小写），无需回车或按钮；
                             行几何与下方工作区行同构（图标 16 + 间距 8 + 文字），关闭面板时
                             由 VM 清空并恢复全量。 -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                              MinHeight="34" Margin="10,1">
                            <!-- DSH IconSearchOutlineRegular（16px、1px 描边），几何同侧栏搜索
                                 （Icons.axaml 统一为贝塞尔版本）。 -->
                            <Path Width="16" Height="16" VerticalAlignment="Center"
                                  Data="{StaticResource Icon.SearchOutlineRegular}"
                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1" />
                            <TextBox Grid.Column="1"
                                     Classes="popup-search"
                                     VerticalAlignment="Center"
                                     Text="{Binding WorkspaceSearchText, Mode=TwoWay}"
                                     PlaceholderText="搜索工作区"
                                     AutomationProperties.Name="搜索工作区" />
                        </Grid>
                        <Border Classes="popup-divider" />
                        <ScrollViewer MaxHeight="288" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding WorkspaceMenuOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkspaceOptionViewModel">
                                        <Button Classes="popup-item"
                                                Classes.selected="{Binding IsSelected}"
                                                Command="{Binding SelectCommand}"
                                                CommandParameter="{Binding}">
                                            <!-- 名称左侧文件夹图标与侧栏工作区分组同款
                                                 （DSH WorkspaceBrowser 16px）；选中勾紧贴
                                                 名称右侧。标题 MaxWidth 截断超长路径名。 -->
                                            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                                <Path Width="16" Height="16" VerticalAlignment="Center"
                                                      Data="{StaticResource Icon.FolderOutline}"
                                                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                                      StrokeLineCap="Round" />
                                                <TextBlock Grid.Column="1" Text="{Binding TitleText}"
                                                           MaxWidth="300"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Path Grid.Column="2" Classes="popup-check"
                                                      Data="{StaticResource Icon.Check}"
                                                      Stroke="{DynamicResource PopupForegroundBrush}"
                                                      StrokeThickness="1"
                                                      IsVisible="{Binding IsSelected}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Classes="popup-divider" />
                        <!-- 添加工作区：文件夹对话框与侧栏入口同一视图行为（见 code-behind），
                             登记编排走 MainWindowViewModel.RegisterWorkspaceAsync。 -->
                        <Button x:Name="AddWorkspaceButton" Classes="popup-item"
                                AutomationProperties.Name="添加工作区"
                                ToolTip.Tip="添加工作区">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Path Width="16" Height="16" VerticalAlignment="Center"
                                      Data="{StaticResource Icon.PlusOutline}"
                                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1" />
                                <TextBlock Grid.Column="1" Text="添加工作区" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <!-- 「不使用工作区」兼容项：从滚动列表挪到固定底行，命令与勾选态
                             沿用兼容项实例；空图标列保持标题与上方工作区行对齐。 -->
                        <Button Classes="popup-item"
                                Classes.selected="{Binding WithoutWorkspaceOption.IsSelected}"
                                Command="{Binding WithoutWorkspaceOption.SelectCommand}"
                                CommandParameter="{Binding WithoutWorkspaceOption}"
                                AutomationProperties.Name="不使用工作区">
                            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                <Panel Grid.Column="0" Width="16" Height="16" />
                                <TextBlock Grid.Column="1" Text="不使用工作区" VerticalAlignment="Center" />
                                <Path Grid.Column="2" Classes="popup-check"
                                      Data="{StaticResource Icon.Check}"
                                      Stroke="{DynamicResource PopupForegroundBrush}" StrokeThickness="1"
                                      IsVisible="{Binding WithoutWorkspaceOption.IsSelected}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
            <!-- 模式弹出：dsh 内置四模式（名称 + 一句话说明两行条目，选中行打勾）。
                 定位与工作区下拉同惯例（TopEdgeAlignedLeft）：按钮贴窗口底部，弹出只
                 能向上。固定宽度让长描述按行宽换行，面板不随文案撑破。 -->
            <Popup x:Name="PresetPickerPopup"
                   PlacementTarget="{Binding #PresetPickerButton}"
                   Placement="TopEdgeAlignedLeft"
                   VerticalOffset="-4"
                   IsOpen="{Binding IsPresetMenuOpen, Mode=TwoWay}"
                   IsLightDismissEnabled="True">
                <Border Classes="popup-surface" Width="316">
                    <ItemsControl ItemsSource="{Binding AgentPresetOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AgentPresetOptionViewModel">
                                <Button Classes="popup-item"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding SelectCommand}"
                                        CommandParameter="{Binding}">
                                    <!-- 左列两行（名称 + 弱化说明），勾选标记对齐名称行
                                         （顶部），同 DSH 预设下拉条目形态。 -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,7">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontSize="13" />
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PopupMutedForegroundBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="popup-check"
                                              VerticalAlignment="Top" Margin="8,2,2,0"
                                              Data="{StaticResource Icon.Check}"
                                              Stroke="{DynamicResource PopupForegroundBrush}"
                                              StrokeThickness="1"
                                              IsVisible="{Binding IsSelected}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
            <!-- 输入卡片：与底部输入区同款面板、同宽同位置；错误提示、模型预选与发送同基线。
                 「不使用工作区」必须经下拉显式选择，发送按钮才可用。 -->
            <StackPanel Grid.Row="2" Spacing="6" Margin="28,0,28,16">
                <Border x:Name="ComposerSurface" Classes="composer-panel">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ErrorText}"
                                   IsVisible="{Binding HasError}"
                                   Foreground="{DynamicResource StatusErrorBrush}"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="MessageInput"
                                 Classes="composer-input"
                                 AutomationProperties.Name="新对话输入框"
                                 Text="{Binding Composer.DraftMessage, Mode=TwoWay}"
                                 PlaceholderText="输入消息…"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <!-- 工具行：左侧附件占位与执行权限预选，右侧模型预选与发送同基线。
                             权限在草稿页是本地预选（无会话，不发 RPC）：经回调记入草稿，
                             首发送创建会话后、首条消息前经 /permission 应用；会话开始后
                             由 permissions 投影回流接管显示。 -->
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                            <Button Classes="composer-icon"
                                    IsEnabled="False"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="附件功能尚未接入">
                                <Viewbox Width="15" Height="15">
                                    <Path Data="{StaticResource Icon.PlusLarge}"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="2" />
                                </Viewbox>
                            </Button>
                            <conversation:PermissionSelectorView Grid.Column="1" VerticalAlignment="Center"
                                                                 DataContext="{Binding PermissionSelector}" />
                            <conversation:ModelPickerView Grid.Column="3" VerticalAlignment="Center"
                                                          DataContext="{Binding Composer}" />
                            <Button Grid.Column="4"
                                    Classes="composer-send"
                                    Command="{Binding SendDraftCommand}"
                                    AutomationProperties.Name="发送首条消息"
                                    ToolTip.Tip="发送">
                                <Viewbox Width="16" Height="16">
                                    <!-- 同 ComposerView：Path 须显式撑满 24 viewBox 才不偏离圆心。 -->
                                    <Path Width="24" Height="24"
                                          Data="{StaticResource Icon.ArrowUp}"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="2" />
                                </Viewbox>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- 卡片外侧信息带：与普通会话输入区同构——左侧草稿发送状态、右侧键盘提示，
                     保持两页底部基线一致。 -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="正在创建会话并发送首条消息…"
                               Classes="composer-stat"
                               IsVisible="{Binding IsStartingConversation}" />
                    <TextBlock Grid.Column="1"
                               Text="Enter 发送 · Shift+Enter 换行"
                               Classes="composer-stat" />
                </Grid>
            </StackPanel>
        </Grid>
    </Panel>
</UserControl>
