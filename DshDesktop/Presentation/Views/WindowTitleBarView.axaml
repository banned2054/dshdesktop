<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:vm="using:DshDesktop.ViewModels"
             x:Class="DshDesktop.Presentation.Views.WindowTitleBarView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="1000">
    <!-- 全窗口标题栏：跨整个窗口宽度，不属于 Sidebar 或 Conversation。客户区经
         ExtendClientAreaToDecorationsHint 延伸进系统标题栏后，本视图即窗口 chrome 内容：
         整条标记 ElementRole=TitleBar 承担拖动/双击最大化，交互控件单独标记 User
         保证可点击；右端为装饰主题 overlay 绘制的系统 caption 按钮留白。
         只承载窗口级内容（侧栏开关、将来的全局 toolbar/menu），不放当前会话的
         业务信息——那些属于 Conversation 的 SessionHeaderView。 -->
    <Border Background="{DynamicResource TitleBarBackgroundBrush}"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <Grid ColumnDefinitions="Auto,*,Auto" Height="32" Margin="8,0,0,0">
            <!-- 侧栏折叠/展开开关：位置固定在窗口左上角，不随侧栏折叠移动；
                 折叠本身只上报事件，列宽协调由 MainWindow 完成。 -->
            <Button x:Name="SidebarToggle"
                    Classes="titlebar-icon"
                    VerticalAlignment="Center"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    Click="OnSidebarToggleClick"
                    ToolTip.Tip="收起侧栏"
                    AutomationProperties.Name="收起侧栏">
                <Panel Width="16" Height="16">
                    <!-- 左栏可见时显示向左双箭头（收起）；折叠后切换为向右双箭头（展开）。 -->
                    <Path x:Name="CollapseSidebarIcon"
                          Data="{StaticResource Icon.SidebarCollapse}"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Path x:Name="ExpandSidebarIcon"
                          Data="{StaticResource Icon.SidebarExpand}"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsVisible="False" />
                </Panel>
            </Button>
            <!-- 全局 toolbar 菜单落位区：首个菜单为「帮助」，入口在标题栏、内容随菜单项
                 以窗口级覆盖层展开。ElementRole=User 保证菜单按钮不被标题栏拖动吞掉点击。 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <Button x:Name="HelpMenuButton"
                        Classes="titlebar-menu"
                        chrome:WindowDecorationProperties.ElementRole="User"
                        Command="{Binding ToggleHelpMenuCommand}"
                        Content="帮助"
                        AutomationProperties.Name="帮助" />
                <Popup PlacementTarget="{Binding #HelpMenuButton}"
                       Placement="BottomEdgeAlignedLeft"
                       VerticalOffset="2"
                       IsOpen="{Binding IsHelpMenuOpen, Mode=TwoWay}"
                       IsLightDismissEnabled="True">
                    <Border Classes="popup-surface">
                        <Button Classes="popup-item"
                                Padding="12,8"
                                Command="{Binding ShowAboutCommand}"
                                Content="关于 DSH Desktop"
                                AutomationProperties.Name="关于 DSH Desktop" />
                    </Border>
                </Popup>
            </StackPanel>
            <!-- caption 按钮留白：宽度与装饰主题的三枚按钮一致，overlay 绘制于其上方。 -->
            <Panel Grid.Column="2" Width="{DynamicResource TitleBarCaptionAreaWidth}" />
        </Grid>
    </Border>
</UserControl>
