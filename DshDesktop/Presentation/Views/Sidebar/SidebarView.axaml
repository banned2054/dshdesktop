<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DshDesktop.ViewModels"
             xmlns:sidebar="using:DshDesktop.Presentation.Views.Sidebar"
             x:Class="DshDesktop.Presentation.Views.Sidebar.SidebarView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="280">
    <!-- 侧栏内容视图：拖拽调宽、折叠等窗口级布局由 MainWindow 统一协调（见 MainWindow.axaml.cs）。
         宽度上限经 SetSurfaceMaxWidth 与外层 Grid 列同步。 -->
    <Border x:Name="Surface"
            MinWidth="240" MaxWidth="480"
            Background="{DynamicResource SidebarBackgroundBrush}" Padding="12,16,12,12">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <!-- 头部：应用图标 + 名称同行，文字相对图标垂直居中，整组相对侧栏内容区
                 水平居中（图标与 exe/窗口图标同源，见 Assets/app-icon.*）。 -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Image Width="64" Height="64"
                       Source="avares://DshDesktop/Assets/app-icon.png" />
                <TextBlock Text="DSH Desktop" Classes="heading"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 顶部「新建会话」：DSH newSession 形态——左侧 16px 圆形加号图标，
                 图标与文字间距 6，实底按钮样式见 Button.new-session。 -->
            <Button Grid.Row="1"
                    Margin="0,24,0,10"
                    Classes="new-session"
                    AutomationProperties.Name="新建会话"
                    Command="{Binding Sidebar.NewSessionCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="16" Height="16"
                          Data="M8,1.5 A6.5,6.5 0 1 0 8,14.5 A6.5,6.5 0 1 0 8,1.5 Z M5,8 L11,8 M8,5 L8,11"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                          StrokeLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="新建会话" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 头部行：标签 + 三个图标按钮（搜索 / 分组方式 / 添加工作区），图标取自
                 DSH WorkspaceBrowser 头部行（IconSearchOutlineRegular /
                 IconSlidersTwoOutlineRegular / IconProjectAddOutlineRegular，16px、1px 描边）。
                 搜索展开时标签与按钮整体让位，搜索行覆盖整行（DSH sectionLabelHidden /
                 headerActionsHidden 同语义）；添加工作区的文件夹对话框是视图行为，
                 见 code-behind，登记编排走 MainWindowViewModel.RegisterWorkspaceAsync。 -->
            <Grid Grid.Row="2" Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                <TextBlock Text="会话" Classes="caption" VerticalAlignment="Center"
                           IsVisible="{Binding !Sidebar.IsSearchOpen}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                            IsVisible="{Binding !Sidebar.IsSearchOpen}">
                    <Button x:Name="SearchButton" Classes="sidebar-icon"
                            AutomationProperties.Name="搜索会话"
                            ToolTip.Tip="搜索会话"
                            Command="{Binding Sidebar.OpenSearchCommand}">
                        <!-- DSH 折叠态搜索按钮内图标 14px；滑块与加号为 16px。 -->
                        <Path Width="14" Height="14"
                              Data="M6.58727,11.8586 C9.55061,11.8586 11.9529,9.45637 11.9529,6.49304 C11.9529,3.5297 9.55061,1.12744 6.58727,1.12744 C3.62394,1.12744 1.22168,3.5297 1.22168,6.49304 C1.22168,9.45637 3.62394,11.8586 6.58727,11.8586 Z M10.2991,10.3933 L14.7783,14.8725"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1"
                              StrokeLineCap="Round" />
                    </Button>
                    <Panel>
                        <Button x:Name="GroupMenuButton" Classes="sidebar-icon"
                                AutomationProperties.Name="分组方式"
                                ToolTip.Tip="分组方式"
                                Command="{Binding Sidebar.ToggleGroupMenuCommand}">
                            <!-- DSH IconSlidersTwoOutlineRegular：双滑块，各带一枚圆钮。 -->
                            <Path Width="16" Height="16"
                                  Data="M2.3,5 L8.15,5 M12.05,5 L13.7,5 M8.5,5 A1.45,1.45 0 1 0 11.4,5 A1.45,1.45 0 1 0 8.5,5 Z M2.3,11 L3.95,11 M7.85,11 L13.7,11 M4.3,11 A1.45,1.45 0 1 0 7.2,11 A1.45,1.45 0 1 0 4.3,11 Z"
                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1"
                                  StrokeLineCap="Round" />
                        </Button>
                        <!-- 分组方式弹层：复用通用弹层菜单视觉（popup-surface/popup-item），
                             选中即应用并收起（对齐 DSH ViewOptionsMenu 行为）。 -->
                        <Popup PlacementTarget="{Binding #GroupMenuButton}"
                               Placement="BottomEdgeAlignedRight"
                               VerticalOffset="4"
                               IsOpen="{Binding Sidebar.IsGroupMenuOpen, Mode=TwoWay}"
                               IsLightDismissEnabled="True">
                            <!-- DSH viewOptionsMenu 的 min-width 200；标签短，定宽保持稳定观感。 -->
                            <Border Classes="popup-surface" Width="200">
                                <StackPanel>
                                    <TextBlock Classes="popup-section" Text="分组方式" />
                                    <Button Classes="popup-item"
                                            Classes.selected="{Binding Sidebar.IsGroupByWorkspace}"
                                            Command="{Binding Sidebar.SetGroupByWorkspaceCommand}"
                                            AutomationProperties.Name="按工作区分组">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="按工作区" />
                                            <Path Grid.Column="1" Classes="popup-check"
                                                  Data="M2.25,8.5 L5.49732,11.7473 C5.90519,12.1552 6.57263,12.1344 6.95426,11.7018 L13.75,4"
                                                  Stroke="{DynamicResource PopupForegroundBrush}" StrokeThickness="1"
                                                  IsVisible="{Binding Sidebar.IsGroupByWorkspace}" />
                                        </Grid>
                                    </Button>
                                    <Button Classes="popup-item"
                                            Classes.selected="{Binding Sidebar.IsGroupFlat}"
                                            Command="{Binding Sidebar.SetGroupFlatCommand}"
                                            AutomationProperties.Name="单列表显示">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="单列表" />
                                            <Path Grid.Column="1" Classes="popup-check"
                                                  Data="M2.25,8.5 L5.49732,11.7473 C5.90519,12.1552 6.57263,12.1344 6.95426,11.7018 L13.75,4"
                                                  Stroke="{DynamicResource PopupForegroundBrush}" StrokeThickness="1"
                                                  IsVisible="{Binding Sidebar.IsGroupFlat}" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Panel>
                    <Button x:Name="AddWorkspaceButton" Classes="sidebar-icon"
                            AutomationProperties.Name="添加工作区"
                            ToolTip.Tip="添加工作区">
                        <!-- DSH IconProjectAddOutlineRegular：文件夹描边形（fill）+ 右上加号（stroke）。 -->
                        <Panel>
                            <Path Width="16" Height="16"
                                  Data="M5.54492,2.06738 C5.91034,2.06754 6.26318,2.20149 6.53711,2.44336 L7.94043,3.68164 L7.94043,4.7998 C7.71462,4.74105 7.50367,4.63139 7.32617,4.47461 L5.87598,3.19238 C5.78477,3.11185 5.66658,3.06754 5.54492,3.06738 L2.94922,3.06738 C2.67322,3.06738 2.44946,3.29145 2.44922,3.56738 L2.44922,12.4326 C2.44927,12.7087 2.67311,12.9326 2.94922,12.9326 L12.9326,12.9326 C13.2086,12.9325 13.4326,12.7086 13.4326,12.4326 L13.4326,8.53613 L14.4326,8.53613 L14.4326,12.4326 C14.4326,13.2609 13.7609,13.9325 12.9326,13.9326 L2.94922,13.9326 C2.12083,13.9326 1.44927,13.261 1.44922,12.4326 L1.44922,3.56738 C1.44946,2.73916 2.12094,2.06738 2.94922,2.06738 L5.54492,2.06738 Z"
                                  Fill="{DynamicResource TextMutedBrush}" />
                            <Path Width="16" Height="16"
                                  Data="M9.75977,4.50208 L14.5509,4.50208 M12.1492,6.89758 L12.1492,2.10642"
                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1"
                                  StrokeLineCap="Round" />
                        </Panel>
                    </Button>
                </StackPanel>
                <!-- 搜索行：覆盖整行并左右各溢出 2px（DSH searchExpanded 的
                     margin-inline: -2px）；透明底细描边容器内：11px 放大镜 +
                     输入框 + 24×24 圆形关闭按钮（DSH clearButton，IconCloseFillRegular）。
                     展开聚焦与 Esc 收起是视图行为，见 code-behind。 -->
                <Border Grid.ColumnSpan="2" Classes="sidebar-search" Margin="-2,0"
                        IsVisible="{Binding Sidebar.IsSearchOpen}">
                    <Grid ColumnDefinitions="28,*,Auto">
                        <Panel VerticalAlignment="Center">
                            <Path Width="11" Height="11" HorizontalAlignment="Center"
                                  Data="M6.58727,11.8586 C9.55061,11.8586 11.9529,9.45637 11.9529,6.49304 C11.9529,3.5297 9.55061,1.12744 6.58727,1.12744 C3.62394,1.12744 1.22168,3.5297 1.22168,6.49304 C1.22168,9.45637 3.62394,11.8586 6.58727,11.8586 Z M10.2991,10.3933 L14.7783,14.8725"
                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1" />
                        </Panel>
                        <!-- Margin 上 2：布局已居中后，CJK 字形在行框内仍光学偏上约 1px
                             （居中对齐下上边距只下移半程），实测微调，动布局前先看这行。 -->
                        <TextBox Grid.Column="1"
                                 x:Name="SessionSearchInput"
                                 Classes="sidebar-search-input"
                                 VerticalAlignment="Center"
                                 Margin="0,2,0,0"
                                 Text="{Binding Sidebar.SessionSearchText, Mode=TwoWay}"
                                 PlaceholderText="搜索会话名称"
                                 AutomationProperties.Name="搜索会话" />
                        <Button Grid.Column="2" Classes="sidebar-icon"
                                Width="24" Height="24" CornerRadius="12"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="关闭搜索"
                                ToolTip.Tip="关闭搜索"
                                Command="{Binding Sidebar.CloseSearchCommand}">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Data="M3.5,3.5 L12.5,12.5 M12.5,3.5 L3.5,12.5"
                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1"
                                  StrokeLineCap="Round" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- 横向滚动禁用 + 全链路显式 Stretch（ScrollViewer→ItemsControl→ItemsPanel→行按钮）：
                 列表行宽度钉死在侧栏内容区宽度（占满减去固定边距），
                 不随标题长度伸缩；超长标题由行内 TextTrimming 省略号截断，
                 对齐 WebUI 的固定行宽列表。 -->
            <ScrollViewer Grid.Row="3" Background="Transparent"
                          Margin="0,0,-12,0"
                          HorizontalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Sidebar.SessionRows}"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,20,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <DataTemplate x:DataType="vm:SessionGroupHeaderViewModel">
                            <!-- 整行一个圆角矩形（Border.group-row）承担悬停/选中底色；
                                 右侧悬浮按钮组（工作区菜单 + 新建会话）平时隐藏，
                                 悬停整行时淡入（显隐样式见 Sidebar.axaml 的 workspace-actions）。
                                 右键整行打开工作区菜单（位置随点击处，见 code-behind）。 -->
                            <Border Classes="group-row" Classes.current="{Binding IsCurrent}"
                                    PointerPressed="OnWorkspaceRowPointerPressed">
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                    <Button Grid.Column="0" Classes="group-header" Margin="0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="{Binding TitleText}"
                                            Command="{Binding $parent[sidebar:SidebarView].DataContext.Sidebar.ToggleGroupCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4"
                                              HorizontalAlignment="Stretch">
                                            <!-- 展开/折叠状态：收起向右、展开向下（DSH arrowOpen 旋转语义）。 -->
                                            <Panel Grid.Column="0" Width="8" Height="16" VerticalAlignment="Center">
                                                <Panel VerticalAlignment="Center" Width="8" Height="8">
                                                    <Path Data="M0,0 L4,4 L0,8"
                                                          Stroke="{DynamicResource TextMutedBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeLineCap="Round"
                                                          IsVisible="{Binding !IsExpanded}" />
                                                    <Path Data="M0,4 L4,8 L8,4"
                                                          Stroke="{DynamicResource TextMutedBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeLineCap="Round"
                                                          IsVisible="{Binding IsExpanded}" />
                                                </Panel>
                                            </Panel>
                                            <!-- DSH WorkspaceBrowser 的 16px 工作区文件夹图标
                                             （slot 16×20，label-tertiary 描边风格）。 -->
                                            <Path Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center"
                                                  Data="M2,11.5 L2,4.5 A1.5,1.5 0 0 1 3.5,3 L6.4,3 A1.5,1.5 0 0 1 7.6,3.6 L8.6,5 L13.5,5 A1.5,1.5 0 0 1 15,6.5 L15,11.5 A1.5,1.5 0 0 1 13.5,13 L3.5,13 A1.5,1.5 0 0 1 2,11.5 Z"
                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                                  StrokeLineCap="Round" />
                                            <TextBlock Grid.Column="2" Text="{Binding TitleText}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding TitleText}" />
                                        </Grid>
                                    </Button>
                                    <StackPanel Grid.Column="1" Classes="workspace-actions"
                                                Orientation="Horizontal" Spacing="2"
                                                IsVisible="{Binding IsWorkspace}">
                                        <!-- 工作区菜单：水平三点按钮 + 行内弹层（重命名 / 删除工作区，
                                             对齐 DSH ProjectRowItem 菜单）。开关是纯视图行为
                                             （每行一个 Popup 实例，经 code-behind 开合），
                                             业务经 Sidebar 的工作区管理命令走 root 编排。 -->
                                        <Panel>
                                            <Button Classes="workspace-menu"
                                                    Click="OnWorkspaceMenuClick"
                                                    AutomationProperties.Name="工作区菜单">
                                                <Path Width="16" Height="16"
                                                      Data="M3.5,8 m-1.25,0 a1.25,1.25 0 1,0 2.5,0 a1.25,1.25 0 1,0 -2.5,0 M8,8 m-1.25,0 a1.25,1.25 0 1,0 2.5,0 a1.25,1.25 0 1,0 -2.5,0 M12.5,8 m-1.25,0 a1.25,1.25 0 1,0 2.5,0 a1.25,1.25 0 1,0 -2.5,0"
                                                      Fill="{DynamicResource TextMutedBrush}" />
                                            </Button>
                                            <Popup Placement="BottomEdgeAlignedLeft"
                                                   VerticalOffset="4"
                                                   IsLightDismissEnabled="True">
                                                <Border Classes="popup-surface" Width="168">
                                                    <StackPanel>
                                                        <Button Classes="popup-item"
                                                                Click="OnWorkspaceMenuItemClick"
                                                                Command="{Binding $parent[sidebar:SidebarView].DataContext.Sidebar.OpenWorkspaceRenameCommand}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="重命名工作区">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                                <!-- DSH IconEditOutlineRegular：fill 框身 + stroke 笔杆。 -->
                                                                <Panel Width="14" Height="14"
                                                                       VerticalAlignment="Center">
                                                                    <Path Width="14" Height="14"
                                                                          Data="M8.85596,2.69971 H4.19971 C3.37141,2.69971 2.69992,3.37146 2.69971,4.19971 V11.8003 C2.69992,12.6285 3.37141,13.3003 4.19971,13.3003 H11.8003 C12.6283,13.2999 13.3001,12.6283 13.3003,11.8003 V7.89893 H14.3003 V11.8003 C14.3001,13.1806 13.1806,14.2999 11.8003,14.3003 H4.19971 C2.81913,14.3003 1.69992,13.1808 1.69971,11.8003 V4.19971 C1.69992,2.81918 2.81913,1.69971 4.19971,1.69971 H8.85596 V2.69971 Z"
                                                                          Fill="{Binding $parent[Button].Foreground}" />
                                                                    <Path Width="14" Height="14"
                                                                          Data="M7.7849,8.23878 L13.888,2.13574"
                                                                          Stroke="{Binding $parent[Button].Foreground}"
                                                                          StrokeThickness="1" />
                                                                </Panel>
                                                                <TextBlock Grid.Column="1" Text="重命名" />
                                                            </Grid>
                                                        </Button>
                                                        <Button Classes="popup-item popup-item-danger"
                                                                Click="OnWorkspaceMenuItemClick"
                                                                Command="{Binding $parent[sidebar:SidebarView].DataContext.Sidebar.OpenWorkspaceDeleteCommand}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="删除工作区">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                                <!-- DSH IconTrashOutlineRegular：横梁 + 提手 + 桶身 + 两竖纹。 -->
                                                                <Path Grid.Column="0" Width="14" Height="14"
                                                                      VerticalAlignment="Center"
                                                                      Data="M1.28149,3.88831 H14.7187 M5.41602,3.88833 V2.47962 C5.41602,2.29282 5.52492,2.11366 5.71876,1.98157 C5.9126,1.84948 6.17551,1.77527 6.44964,1.77527 H9.55053 C9.82466,1.77527 10.0876,1.84948 10.2814,1.98157 C10.4753,2.11366 10.5842,2.29282 10.5842,2.47962 V3.88833 M2.57349,3.88831 L3.19366,13.2943 C3.21937,13.5502 3.33952,13.7872 3.53065,13.9593 C3.72178,14.1313 3.97016,14.2259 4.22729,14.2246 H11.7728 C12.0299,14.2259 12.2783,14.1313 12.4694,13.9593 C12.6605,13.7872 12.7807,13.5502 12.8064,13.2943 L13.4266,3.88831 M6.44946,6.98926 V11.1238 M9.55054,6.98926 V11.1238"
                                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                                      StrokeThickness="1" />
                                                                <TextBlock Grid.Column="1" Text="删除工作区" />
                                                            </Grid>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Panel>
                                        <Button Classes="workspace-new-session"
                                                AutomationProperties.Name="在此工作区新建会话"
                                                ToolTip.Tip="在此工作区新建会话"
                                                Command="{Binding $parent[sidebar:SidebarView].DataContext.Sidebar.CreateWorkspaceSessionCommand}"
                                                CommandParameter="{Binding}">
                                            <!-- DSH IconNewChatOutlineMedium：气泡包加号
                                                 （16 viewBox、1.3 描边，默认 butt 线帽）。 -->
                                            <Path Width="16" Height="16"
                                                  Data="M2.37091,11.2501 C1.58745,9.89288 1.32067,8.29835 1.61969,6.76006 C1.91872,5.22177 2.76342,3.8433 3.99826,2.87846 C5.2331,1.91362 6.77494,1.42737 8.33988,1.50925 C9.90482,1.59113 11.3875,2.23562 12.5149,3.32406 C13.6425,4.41269 14.3387,5.87206 14.4754,7.4334 C14.612,8.99474 14.18,10.5529 13.2587,11.8209 C12.3375,13.0888 10.9891,13.9813 9.46194,14.3337 C8.18691,14.628 6.85895,14.5294 5.64989,14.0605 C5.1712,13.8748 4.76962,13.4932 4.26534,13.3967 C3.67413,13.2835 2.95257,13.5598 2.03794,14.3337 M8,5 L8,11 M5,8 L11,8"
                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.3" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:DataType="vm:SessionItemViewModel">
                            <Button Classes="session-row"
                                    Classes.current="{Binding IsCurrent}"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{Binding TitleText}"
                                    Command="{Binding $parent[sidebar:SidebarView].DataContext.Sidebar.SelectSessionCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="*,Auto" RowSpacing="5"
                                      HorizontalAlignment="Stretch">
                                    <!-- 标题 14px 与工作区标题同规格（DSH Rows title）；层级由
                                         40px 行缩进表达，不再用字号或字重区分。 -->
                                    <TextBlock Grid.ColumnSpan="1"
                                               Text="{Binding TitleText}"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding TitleText}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{DynamicResource StatusRunningBrush}"
                                                 IsVisible="{Binding Running}" />
                                        <TextBlock Text="{Binding RunningText}" Classes="caption"
                                                   IsVisible="{Binding Running}" />
                                        <TextBlock Text="{Binding UpdatedText}" Classes="caption" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="4"
                    Margin="0,16,0,0"
                    Padding="12"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    CornerRadius="10">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{DynamicResource StatusConnectedBrush}"
                                 IsVisible="{Binding IsBackendConnected}" />
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{DynamicResource TextMutedBrush}"
                                 IsVisible="{Binding IsBackendDisconnected}" />
                        <TextBlock Text="{Binding BackendStatusText}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="{Binding BackendErrorDetail}" Classes="caption" TextWrapping="Wrap"
                               IsVisible="{Binding HasBackendError}" />
                    <TextBlock Text="{Binding SimulationNotice}" Classes="caption" TextWrapping="Wrap"
                               IsVisible="{Binding IsSimulationMode}" />
                </StackPanel>
            </Border>

            <!-- 工作区重命名弹窗：对齐 DSH WorkspaceBrowser 的重命名 Modal——预填当前名并全选，
                 Enter 确认、Esc/取消/浅失焦关闭；确认经 Sidebar 走 root 编排，错误留在弹窗内呈现。
                 弹窗实例全局一份（状态在 SidebarViewModel），不随行投影重复创建。 -->
            <Popup x:Name="WorkspaceRenamePopup"
                   PlacementTarget="{Binding #Surface}" Placement="Center"
                   IsOpen="{Binding Sidebar.IsRenameOpen, Mode=TwoWay}"
                   IsLightDismissEnabled="True">
                <Border Classes="popup-surface" Width="320" Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="重命名工作区"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PopupForegroundBrush}" />
                        <TextBox x:Name="WorkspaceRenameInput"
                                 Classes="popup-input"
                                 Text="{Binding Sidebar.RenameDraftText, Mode=TwoWay}"
                                 AutomationProperties.Name="工作区名称" />
                        <TextBlock Classes="popup-error"
                                   Text="{Binding Sidebar.RenameErrorText}"
                                   IsVisible="{Binding Sidebar.HasRenameError}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="approval-reject" Content="取消"
                                    Command="{Binding Sidebar.CancelWorkspaceRenameCommand}" />
                            <Button Classes="approval-allow" Content="重命名"
                                    Command="{Binding Sidebar.ConfirmWorkspaceRenameCommand}"
                                    IsEnabled="{Binding Sidebar.CanConfirmRename}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- 删除工作区确认弹窗：对齐 DSH delete Modal 文案语义——只移出列表，目录与会话保留；
                 确认经 Sidebar 走 root 编排，失败留弹窗内可重试；无确认输入门槛（取消即可放弃）。 -->
            <Popup x:Name="WorkspaceDeletePopup"
                   PlacementTarget="{Binding #Surface}" Placement="Center"
                   IsOpen="{Binding Sidebar.IsDeleteConfirmOpen, Mode=TwoWay}"
                   IsLightDismissEnabled="True">
                <Border Classes="popup-surface" Width="320" Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="删除工作区"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PopupForegroundBrush}" />
                        <TextBlock Text="{Binding Sidebar.DeleteConfirmText}"
                                   FontSize="12" TextWrapping="Wrap" LineHeight="18"
                                   Foreground="{DynamicResource PopupMutedForegroundBrush}" />
                        <TextBlock Classes="popup-error"
                                   Text="{Binding Sidebar.DeleteErrorText}"
                                   IsVisible="{Binding Sidebar.HasDeleteError}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="approval-reject" Content="取消"
                                    Command="{Binding Sidebar.CancelWorkspaceDeleteCommand}" />
                            <Button Classes="popup-danger-action" Content="删除工作区"
                                    Command="{Binding Sidebar.ConfirmWorkspaceDeleteCommand}"
                                    IsEnabled="{Binding Sidebar.CanConfirmDelete}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
