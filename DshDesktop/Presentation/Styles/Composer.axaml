<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 底部输入区样式：输入面板、工具行按钮、模型下拉与统计条。 -->

    <!-- 底部输入区的面板：对齐 WebUI 的输入卡片——上方输入区、下方工具行，
         统计条留在卡片外侧；面板高度随文本与错误提示增长。 -->
    <Style Selector="Border.composer-panel">
        <Setter Property="Background" Value="{DynamicResource ComposerBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="8,8,8,6" />
    </Style>
    <!-- 输入框聚焦的克制反馈：整块面板描边轻微提亮（code-behind 切换 focused 类），
         输入框内部不绘制任何独立边框或底色，对齐 WebUI 的卡片级聚焦高亮。 -->
    <Style Selector="Border.composer-panel.focused">
        <Setter Property="BorderBrush" Value="{DynamicResource ComposerFocusRingBrush}" />
    </Style>
    <!-- 面板内输入框不自带边框与底色，视觉容器由输入面板承担；
         采用 WebUI 的紧凑单行基线，多行时由 TextBox 自然增高。 -->
    <Style Selector="TextBox.composer-input">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MaxHeight" Value="200" />
        <Setter Property="Padding" Value="6,4,8,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ComposerTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ComposerTextBrush}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource ComposerTextMutedBrush}" />
    </Style>
    <!-- Fluent 把 TextBox 的状态底色与描边画在模板部件 Border#PART_BorderElement 上：
         聚焦时该部件会换成强调色描边加深色填充，仅改控件的 Background/BorderThickness
         （模板绑定源）压不住这些状态样式；必须逐状态覆盖模板部件本身，
         输入框悬停/聚焦下才能保持透明无描边、与面板融为一体。 -->
    <Style Selector="TextBox.composer-input /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style
        Selector="TextBox.composer-input:pointerover /template/ Border#PART_BorderElement,
                     TextBox.composer-input:focus /template/ Border#PART_BorderElement,
                     TextBox.composer-input:focus-visible /template/ Border#PART_BorderElement,
                     TextBox.composer-input:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- 工具栏圆形图标按钮（附件等占位）：Fluent 把状态底色画在模板 ContentPresenter 上，
         悬停/禁用态需覆盖该部件而非按钮的 Background。 -->
    <Style Selector="Button.composer-icon">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ComposerTextMutedBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.composer-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
    </Style>
    <Style Selector="Button.composer-icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 圆形发送按钮：尺寸和配色对齐 WebUI 的 34px primary icon button。 -->
    <Style Selector="Button.composer-send">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource ComposerActionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.composer-send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ComposerSendHoverBrush}" />
    </Style>
    <Style Selector="Button.composer-send:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ComposerActionBrush}" />
    </Style>
    <Style Selector="Button.composer-send:disabled">
        <Setter Property="Foreground" Value="{DynamicResource ComposerTextMutedBrush}" />
    </Style>
    <Style Selector="Button.composer-send:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ComposerControlBrush}" />
    </Style>
    <!-- 生成中的圆形停止按钮沿用发送按钮尺寸，保持工具行基线稳定。 -->
    <Style Selector="Button.composer-stop">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Background" Value="{DynamicResource ComposerControlBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.composer-stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
    </Style>
    <Style Selector="Button.composer-stop:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
    </Style>
    <!-- 模型/推理等级选择按钮：面板内紧凑尺寸；点击弹出两级菜单（行样式见 PopupMenus）。 -->
    <Style Selector="Button.model-picker-button">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource ComposerControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ComposerTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Fluent 把按钮状态底色画在模板 ContentPresenter 上：悬停微亮，禁用保持控件底色。 -->
    <Style Selector="Button.model-picker-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PopupItemHoverBrush}" />
    </Style>
    <Style Selector="Button.model-picker-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ComposerControlBrush}" />
    </Style>
    <Style Selector="StackPanel.composer-stats">
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Spacing" Value="14" />
    </Style>
    <Style Selector="TextBlock.composer-stat">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ComposerTextMutedBrush}" />
    </Style>
</Styles>
