<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>DshDesktop</RootNamespace>
		<!-- 本项目自身版本（关于面板显示；DSH 后端版本运行时从 runtime 目录读取，与此独立）。
		     IncludeSourceRevisionInInformationalVersion=false：.NET 10 SDK 在 git 仓库内默认把
		     commit SHA 追加为 InformationalVersion 构建元数据（0.1.0+sha），关于面板只想要纯版本号。 -->
		<Version>0.1.0-rc.1</Version>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<PublishAot>true</PublishAot>
		<TrimMode>partial</TrimMode>
		<InvariantGlobalization>true</InvariantGlobalization>
		<!-- 旧空白流程视图（WorkspaceHeroView）已被 NewConversationView 取代：源文件按约定
         原样保留在仓库，但不参与编译——其编译绑定指向已收束的空白流程状态，保留在
         编译范围会让完整构建失败（AVLN2000，见阶段记录）。 -->
		<DefaultItemExcludes>$(DefaultItemExcludes);Presentation\Views\Conversation\WorkspaceHeroView.axaml;Presentation\Views\Conversation\WorkspaceHeroView.axaml.cs</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<!-- 应用图标：ico 供 exe/窗口图标，png 供侧栏头部等界面内显示。 -->
		<AvaloniaResource Include="Assets\**" />
		<InternalsVisibleTo Include="DshDesktop.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DshDesktop.Core\DshDesktop.Core.csproj" />
		<ProjectReference Include="..\DshDesktop.Harness\DshDesktop.Harness.csproj" />
		<ProjectReference Include="..\DshDesktop.Infrastructure\DshDesktop.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.3" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
		<PackageReference Include="Banned.CodeDiff.Avalonia" Version="0.1.0" />
		<PackageReference Include="LiveMarkdown.Avalonia" Version="2.4.3" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
	</ItemGroup>
</Project>
