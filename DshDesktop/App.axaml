<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DshDesktop.App"
             RequestedThemeVariant="Dark">
    <!-- 应用主题由 RequestedThemeVariant 指定；界面样式与颜色定义在 Presentation/Styles。 -->

    <Application.Styles>
        <FluentTheme />
        <!-- 文件改动右侧对比面板使用的 DiffView 控件样式。 -->
        <StyleInclude Source="avares://Banned.CodeDiff.Avalonia/Themes/Generic.axaml" />
        <StyleInclude Source="avares://DshDesktop/Presentation/Styles/ScrollBars.axaml" />
        <!-- LiveMarkdown.Avalonia 控件样式（代码块、行内代码、链接等）；须在 FluentTheme
             与应用自身的 Markdown 覆盖样式之间加载。 -->
        <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
        <StyleInclude Source="avares://DshDesktop/Presentation/Styles/Markdown.axaml" />
        <StyleInclude Source="avares://DshDesktop/Presentation/Styles/Typography.axaml" />
        <StyleInclude Source="avares://DshDesktop/Presentation/Styles/PopupMenus.axaml" />
        <StyleInclude Source="avares://DshDesktop/Presentation/Styles/Conversation.axaml" />
        <StyleInclude Source="avares://DshDesktop/Presentation/Styles/Tooling.axaml" />
        <StyleInclude Source="avares://DshDesktop/Presentation/Styles/Sidebar.axaml" />
        <StyleInclude Source="avares://DshDesktop/Presentation/Styles/Composer.axaml" />
        <StyleInclude Source="avares://DshDesktop/Presentation/Styles/Settings.axaml" />
        <!-- 标题栏样式与窗口装饰主题（caption 按钮）最后引入。 -->
        <StyleInclude Source="avares://DshDesktop/Presentation/Styles/TitleBar.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- LiveMarkdown 默认颜色与字号；应用自身的语义资源键与其不冲突。 -->
                <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
                <ResourceInclude Source="avares://DshDesktop/Presentation/Styles/ThemeResources.axaml" />
                <!-- 图标几何统一入口（Icon.*），视图与样式文件共同引用。 -->
                <ResourceInclude Source="avares://DshDesktop/Presentation/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
